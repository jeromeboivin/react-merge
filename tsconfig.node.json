{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vitest.config.ts",
    "playwright.config.ts",
    "e2e/**/*",
    "src/__tests__/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "types": ["electron-vite/node", "vitest/globals"]
  }
}
